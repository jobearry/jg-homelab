{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/qwen-local",
  "providers": {
    "llama.cpp": {
      "name": "llama.cpp (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8081/v1"
      },
      "models": {
        "qwen-local": {
          "name": "Qwen 3.5 4B Q8 (local)",
          "limit": {
            "context": 16384,
            "output": 2048
          }
        }
      }
    },
    "llama.cpp-coder": {
      "name": "llama.cpp (local coder)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8083/v1"
      },
      "models": {
        "qwen3-4b-instruct-2507": {
          "name": "Qwen3 4B Instruct 2507 (local)",
          "limit": {
            "context": 12288,
            "output": 2048
          }
        }
      }
    }
  }
}
